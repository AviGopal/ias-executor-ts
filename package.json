{
  "name": "@avigopal/ias-executor-ts",
  "version": "0.1.1",
  "description": "Reference TypeScript implementation of the impulse-activity execution model",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./bundles": {
      "types": "./dist/bundles/index.d.ts",
      "import": "./dist/bundles/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "src"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "dist:check": "bun run scripts/verify-dist-fresh.ts"
  },
  "keywords": [
    "impulse",
    "activity",
    "resolver",
    "executor",
    "runtime"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:avigopal/ias-executor-ts.git"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "typescript": "^5.8.3"
  }
}
