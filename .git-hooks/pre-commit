#!/usr/bin/env bash
#
# Vessel-level pre-commit hook.
#
# Install into any repos/<vessel> by running from the super-repo:
#
#   scripts/git-hooks/install.sh --vessel repos/<vessel>
#
# Or manually from inside the vessel repo:
#
#   git config core.hooksPath .git-hooks
#   mkdir -p .git-hooks && cp <path-to-this-file> .git-hooks/pre-commit
#   chmod +x .git-hooks/pre-commit
#
# Rules apply only to NEWLY ADDED or RENAMED-INTO files. Modifying existing
# tracked files is never blocked.
#
# What this enforces:
#   - Vessel root holds only project metadata (package.json, tsconfig, README,
#     .gitignore, lockfiles, dotfile configs). No loose scripts, no tests, no
#     markdown docs at root.
#   - No binary artefacts (PNG, screenshots, etc.) outside designated asset
#     paths (assets/, public/, docs/assets/).
#   - No node_modules/ committed.
#   - No secrets (gitleaks scan when available).

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

RED=$'\033[0;31m'
YELLOW=$'\033[1;33m'
DIM=$'\033[2m'
NC=$'\033[0m'

# Exact-name files allowed at the vessel root.
ROOT_ALLOWLIST=(
  package.json
  bun.lock
  package-lock.json
  yarn.lock
  pnpm-lock.yaml
  tsconfig.json
  tsconfig.base.json
  tsconfig.build.json
  biome.json
  vitest.config.ts
  vitest.config.js
  vite.config.ts
  vite.config.js
  esbuild.config.ts
  esbuild.config.js
  jest.config.ts
  jest.config.js
  .eslintrc.js
  .eslintrc.json
  .eslintignore
  .prettierrc
  .prettierrc.json
  .prettierrc.yaml
  .prettierignore
  .editorconfig
  .gitignore
  .gitattributes
  .nvmrc
  .tool-versions
  .dockerignore
  Dockerfile
  README.md
  CLAUDE.md
  LICENSE
  LICENSE.md
  CHANGELOG.md
  helmfile.yaml
  Makefile
  bunfig.toml
)

# Top-level directories that a vessel may contain.
ALLOWED_VESSEL_DIRS=(
  src
  test
  tests
  __tests__
  scripts
  docs
  assets
  public
  dist
  build
  .out
  migrations
  sql
  charts
  helm
  k8s
  deployment
  config
  configs
  fixtures
  examples
  types
  .github
  .husky
  .git-hooks
)

ARTEFACT_EXTENSIONS='png|jpg|jpeg|gif|webp|svg|bmp|ico|mp4|mov|webm|pdf|zip|tar|gz|tgz'

# Asset paths where binary files are acceptable.
is_asset_path() {
  local f="$1"
  [[ "$f" == assets/* || "$f" == public/* || "$f" == docs/assets/* || "$f" == */assets/* ]]
}

mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=AR)

[[ ${#STAGED[@]} -eq 0 ]] && exit 0

violations=()

is_root_allowlisted() {
  local name="$1"
  for entry in "${ROOT_ALLOWLIST[@]}"; do
    [[ "$name" == "$entry" ]] && return 0
  done
  [[ "$name" == .env.*.example || "$name" == *.env.example ]] && return 0
  return 1
}

is_under_allowed_dir() {
  local path="$1"
  local first="${path%%/*}"
  for dir in "${ALLOWED_VESSEL_DIRS[@]}"; do
    [[ "$first" == "$dir" ]] && return 0
  done
  return 1
}

flag() {
  violations+=("${1}|${2}|${3}")
}

for file in "${STAGED[@]}"; do
  base="$(basename "$file")"
  ext="${base##*.}"
  ext_lower="${ext,,}"

  # node_modules must never be committed.
  if [[ "$file" == node_modules/* || "$file" == */node_modules/* ]]; then
    flag "$file" \
      "node_modules committed" \
      "add node_modules/ to .gitignore; install with bun/npm/yarn at runtime"
    continue
  fi

  if [[ "$file" == */* ]]; then
    # File inside a subdirectory.
    if ! is_under_allowed_dir "$file"; then
      flag "$file" \
        "new file in unrecognised vessel directory '${file%%/*}'" \
        "move to an established directory (src/, test/, scripts/, docs/, assets/), or add the directory to the allowlist in .git-hooks/pre-commit if it's genuinely needed"
      continue
    fi
  else
    # File at the vessel root.
    if ! is_root_allowlisted "$base"; then
      case "$base" in
        *.md)
          flag "$file" \
            "new markdown file at vessel root" \
            "move to docs/<topic>.md; only README.md, CLAUDE.md, CHANGELOG.md, LICENSE.md belong at root"
          ;;
        *.sh|*.ts|*.tsx|*.js|*.mjs|*.cjs|*.py)
          flag "$file" \
            "new script at vessel root" \
            "move to scripts/ — loose scripts at root make the project root noisy"
          ;;
        test-*|*-test.*|*.test.*|tests-*|*.spec.*)
          flag "$file" \
            "new test file at vessel root" \
            "tests belong in test/ or tests/ alongside the code they cover"
          ;;
        *.yaml|*.yml|*.json|*.toml)
          flag "$file" \
            "new config file at vessel root" \
            "if this is a tool config, add it to the ROOT_ALLOWLIST in .git-hooks/pre-commit; otherwise move to config/ or scripts/"
          ;;
        *)
          if [[ "$ext_lower" =~ ^($ARTEFACT_EXTENSIONS)$ ]]; then
            flag "$file" \
              "new binary/artefact at vessel root" \
              "binary assets go in assets/ or public/; screenshots and test output should be gitignored"
          else
            flag "$file" \
              "new file at vessel root not in allowlist" \
              "extend ROOT_ALLOWLIST in .git-hooks/pre-commit only if this is genuinely project-wide metadata"
          fi
          ;;
      esac
      continue
    fi
  fi

  # Cross-cutting: no artefacts outside asset paths.
  if [[ "$ext_lower" =~ ^($ARTEFACT_EXTENSIONS)$ ]]; then
    if ! is_asset_path "$file"; then
      flag "$file" \
        "binary/artefact outside an asset directory" \
        "screenshots and playwright output should be gitignored; illustrative assets go in assets/ or docs/assets/"
    fi
  fi
done

if [[ ${#violations[@]} -gt 0 ]]; then
  printf '%s\n' "${RED}━━━ vessel placement check failed ━━━${NC}"
  printf '%s\n\n' "${DIM}hook: .git-hooks/pre-commit${NC}"

  for v in "${violations[@]}"; do
    IFS='|' read -r file reason remedy <<<"$v"
    printf '  %s %s\n' "${YELLOW}✗${NC}" "$file"
    printf '      %sreason:%s %s\n' "$DIM" "$NC" "$reason"
    printf '      %sfix:   %s %s\n\n' "$DIM" "$NC" "$remedy"
  done

  cat <<EOF
${DIM}Bypass${NC}
  git commit --no-verify   ${DIM}(use sparingly)${NC}
EOF
  exit 1
fi

# ─── secrets scan ───
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --no-banner 2>&1; then
    printf '\n%s\n' "${RED}━━━ gitleaks: secrets detected in staged diff ━━━${NC}"
    cat <<EOF
${DIM}What to do${NC}
  1. Remove the secret from the file before committing.
  2. Rotate the leaked credential immediately.
  3. False positive? Add:  some-value  # gitleaks:allow

${DIM}Bypass${NC}
  git commit --no-verify   ${DIM}(only after rotating the credential)${NC}
EOF
    exit 1
  fi
else
  printf '%s\n' "${YELLOW}note:${NC} gitleaks not installed; secrets scan skipped."
fi

exit 0
